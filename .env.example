# Contact form email (Vercel → Project → Settings → Environment Variables; locally, copy to .env)
# GMAIL_USER: the Gmail address that sends the emails
# GMAIL_APP_PASSWORD: a Google App Password (Google Account → Security → 2-Step Verification → App passwords)
# CONTACT_TO: optional inbox for notifications (defaults to GMAIL_USER)
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO=
